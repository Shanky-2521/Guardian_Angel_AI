# Optional: Add your Anthropic API key for Claude summaries
# If not provided, the system will generate basic summaries without AI
ANTHROPIC_API_KEY=your_api_key_here

# OMI Dev Kit 2 Integration
# Enable OMI recording during alerts
OMI_ENABLED=false
OMI_API_URL=http://localhost:8000/omi
OMI_API_KEY=your_omi_api_key_here
OMI_RECORDING_DURATION=30
